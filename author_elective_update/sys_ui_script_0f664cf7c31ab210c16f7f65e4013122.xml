        <name>x_58872_needit.recent_incidents_for_user</name>
        <script><![CDATA[
var RecentIncidentsUI = Class.create();
RecentIncidentsUI.prototype = {
  initialize: function () {},

  init: function () {
    var self = this;
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { self.refresh(); });
    } else {
      self.refresh();
    }
  },

  refresh: function () {
    this._setStatus('Loading…');

    var self = this;
    var ga = new GlideAjax('IncidentsForUser');
    ga.addParam('sysparm_name', 'getRecentIncidents');
    ga.getXMLAnswer(function (answer) {
      try {
        var items = JSON.parse(answer || '[]');
        self._renderRows(items);
        self._setStatus('Loaded ' + items.length + ' record(s).');
      } catch (e) {
        self._renderRows([]);
        self._setStatus('Error loading incidents.');
      }
    });
  },

  _setStatus: function (msg) {
    var el = document.getElementById('inc_status');
    if (el) el.textContent = msg;
  },

  _escapeHtml: function (str) {
    return (str || '').toString()
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  },

  _renderRows: function (items) {
    var tbody = document.getElementById('inc_tbody');
    if (!tbody) return;

    tbody.innerHTML = '';

    if (!items || items.length === 0) {
      tbody.innerHTML =
        '<tr><td colspan="4" style="padding:10px; color:#75787B;">No incidents found.</td></tr>';
      return;
    }

    var html = '';
    for (var i = 0; i < items.length; i++) {
      var it = items[i];
      html +=
        '<tr>' +
          '<td style="padding:10px; border-bottom:1px solid #EEE;">' + this._escapeHtml(it.number) + '</td>' +
          '<td style="padding:10px; border-bottom:1px solid #EEE;">' + this._escapeHtml(it.short_description) + '</td>' +
          '<td style="padding:10px; border-bottom:1px solid #EEE;">' + this._escapeHtml(it.state) + '</td>' +
          '<td style="padding:10px; border-bottom:1px solid #EEE;">' + this._escapeHtml(it.sys_updated_on) + '</td>' +
        '</tr>';
    }

    tbody.innerHTML = html;
  },

  type: 'RecentIncidentsUI'
};
]]></script>
